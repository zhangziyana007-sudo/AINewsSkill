# 产出目录（每次生成不同）
# 文本资源（小红书素材包、data.json、API JSON）入仓，图片走 GitHub Release（不占仓库体积）
output/*
!output/api/
!output/ai-daily-*
# 项目目录内：默认全部忽略，仅白名单这几项
output/ai-daily-*/*
!output/ai-daily-*/data.json
!output/ai-daily-*/xhs-package.md
!output/ai-daily-*/xhs-package.txt

# 字体文件：忽略全部，白名单核心字体（约 40MB）
fonts/*
!fonts/JetBrainsMono-Bold.ttf
!fonts/SpaceGrotesk-Variable.ttf
!fonts/NotoSansCJKsc-Black.otf
!fonts/Orbitron-Variable.ttf
!fonts/SmileySans-Oblique.ttf
!fonts/K8x12-Pixel.ttf
!fonts/WenQuanDotMatrix.ttf
!fonts/ChuangKeTieJinGang.otf
!fonts/LICENSE.md
!fonts/README.md

# Node
node_modules/

# 系统文件
.DS_Store
Thumbs.db

# 环境变量（密钥）
.env
.env.*
